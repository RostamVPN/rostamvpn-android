<?xml version="1.0" encoding="utf-8"?>
<!--
  NEUTRAL FALLBACK for the connect dial's face. This is not artwork; it is the
  power glyph, and it exists so that every flavor compiles.

  PowerButton references R.drawable.brand_mark inside a branch gated on
  R.bool.brand_has_mascot, and a resource referenced from Kotlin must resolve in
  ALL five flavors even where the branch can never be taken. Only rostam has
  real artwork (src/rostam/res/drawable/brand_mark.xml overrides this one), and
  brand_has_mascot is false everywhere else, so on those four brands this file
  is never drawn.

  It is a GLYPH rather than a copy of Rostam's face on purpose. If a brand ever
  sets branding.hasMascot without supplying its own brand_mark, the failure mode
  must be a generic button — not another brand's mascot rendered as though it
  were theirs. Same principle as the zeroed numbers in values/brand_defaults.xml:
  the cost of forgetting is blandness, never a false claim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="76dp"
    android:height="76dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
